---
import { site, type OpenGraph } from '../lib/site';
import '../styles/site.css';

interface Props {
	title: string;
	description: string;
	analytics?: boolean;
	noindex?: boolean;
	/** Social preview card. Pages that omit it are shared under their own title with the lab's card. */
	og?: OpenGraph;
}

const {
	title,
	description,
	analytics = true,
	noindex,
	og,
} = Astro.props;

const social = (() => {
	if (Astro.site === undefined) throw new Error('Set `site` in astro.config.mjs to build absolute Open Graph URLs.');
	const card: OpenGraph = og === undefined ? { title, type: 'website', ...site.card } : og;
	return {
		...card,
		url: new URL(Astro.url.pathname, Astro.site).href,
		image: new URL(card.image, Astro.site).href,
	};
})();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Theme: a stored choice from the header toggle, else the system's; set before anything paints. -->
		<script is:inline>
			try {
				var t = localStorage.getItem('theme');
				if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
			} catch (e) {}
		</script>
		<meta name="theme-color" content="#f3eee4" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{noindex === true && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<link rel="canonical" href={social.url} />
		<meta property="og:site_name" content="Inductive ML" />
		<meta property="og:type" content={social.type} />
		<meta property="og:title" content={social.title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={social.url} />
		<meta property="og:image" content={social.image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={social.imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@inductive_ml" />
		<meta name="twitter:creator" content="@0xavp" />
		<meta name="twitter:title" content={social.title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={social.image} />
		<meta name="twitter:image:alt" content={social.imageAlt} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..800&family=IBM+Plex+Mono:wght@400;500&family=Doto:wght@400..900&display=swap"
			rel="stylesheet"
		/>
		{analytics && <script is:inline defer src="https://assets.onedollarstats.com/stonks.js"></script>}
	</head>
	<body>
		<slot />
	</body>
</html>
