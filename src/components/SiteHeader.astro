---
import { github, huggingFace } from '../lib/site';

export type NavKey = 'experiments' | 'cupel' | 'about';

interface Props {
	/** The section this page belongs to, or null when it belongs to none. */
	current: NavKey | null;
}

const { current } = Astro.props;

const items: { key: NavKey; label: string; href: string }[] = [
	{ key: 'experiments', label: 'Experiments', href: '/experiments' },
	{ key: 'cupel', label: 'RL Env Audits', href: '/cupel' },
	{ key: 'about', label: 'About', href: '/about' },
];
---

<div class="shell">
	<header class="site-head">
		<a class="wordmark" href="/">Inductive ML</a>
		<nav class="site-nav" aria-label="Primary">
			{
				items.map((item) => (
					<a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
			<a href="https://evals.report" target="_blank" rel="noreferrer">Evals</a>
		</nav>
		<div class="head-links">
			<a class="head-org" href={github.href} target="_blank" rel="noreferrer">{github.k} ↗</a>
			<a class="head-org" href={huggingFace.href} target="_blank" rel="noreferrer">{huggingFace.k} ↗</a>
			<a class="head-contact" href="mailto:aditya@inductive.ml">Contact</a>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark">
				<svg class="i-moon" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.6 5.6 0 0 1 6.4 2.5a5.6 5.6 0 1 0 7.1 7.1Z" fill="currentColor" /></svg>
				<svg class="i-sun" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="currentColor" /><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" /></svg>
			</button>
		</div>
	</header>
</div>

<script>
	// Flip to the opposite of what is showing and remember it (localStorage 'theme'; absent = follow the system).
	document.addEventListener('click', (e) => {
		if (!(e.target instanceof Element) || !e.target.closest('[data-theme-toggle]')) return;
		const root = document.documentElement;
		const shown = root.getAttribute('data-theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		const next = shown === 'dark' ? 'light' : 'dark';
		root.setAttribute('data-theme', next);
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>
