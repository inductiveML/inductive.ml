---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHead from '../components/PageHead.astro';
import '../styles/v9.css';
import SLCPaper from '../components/SLCPaper';
---

<Layout
	title="Staged Learned Coordinates · Inductive ML"
	description="Teaching trees to understand geometry — a plain-English breakdown of staged learned coordinates for gradient boosted trees on continuous tabular data."
>
	<SiteHeader current="experiments" />
	<PageHead back={{ href: '/experiments', label: 'Experiments' }} kicker="Research · Preprint · 2026" animate={true}>
		Teaching Trees to Understand Geometry
	</PageHead>
	<SLCPaper client:load />
	<SiteFooter animate={true} />
</Layout>

