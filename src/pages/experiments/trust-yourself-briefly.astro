---
import { z } from 'astro/zod';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageHead from '../../components/PageHead.astro';
import { Content, frontmatter } from '../../../posts/trust-yourself-briefly.md';
import '../../styles/v9.css';

// Lengths follow what search results and social cards show before truncating.
const post = z
	.object({
		pageTitle: z.string().max(60),
		shareTitle: z.string().max(60),
		description: z.string().min(120).max(160),
		date: z.iso.datetime(),
	})
	.parse(frontmatter);

const published = new Date(post.date).toLocaleDateString('en-GB', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<Layout
	title={post.pageTitle}
	description={post.description}
	og={{
		title: post.shareTitle,
		type: 'article',
		image: '/og/trust-yourself-briefly.png',
		imageAlt:
			'Trust Yourself, Briefly: self-confidence as a warm start for GRPO. Four lines of working, each marked up or down by how sure the model was.',
	}}
>
	<SiteHeader current="experiments" />
	<PageHead back={{ href: '/experiments', label: 'Experiments' }} kicker="Research · GRPO · 2026" animate={true}>
		Trust Yourself, Briefly
	</PageHead>

	<main class="v9">
		<div class="pad">
			<div class="grid12">
				<div class="paper-hero">
					<div class="head">
						<p class="sub">
							Self-confidence as a warm start for GRPO. <em>
								It made learning faster on a toy task. Left on too long, the model gamed it.
							</em>
						</p>
					</div>
					<div class="meta-rail">
						<div class="row"><span>// model</span><span>LFM2.5-2.6B · LoRA</span></div>
						<div class="row"><span>// task</span><span>variable chains</span></div>
						<div class="row"><span>// baseline</span><span>GRPO</span></div>
						<div class="row"><span>// seeds</span><span>5 × 100 · 3 × 200</span></div>
						<div class="row"><span>// status</span><span>published · {published}</span></div>
					</div>
				</div>

				<div class="secbar">
					<span class="num">§ 01</span><span class="ttl">// the write-up</span><span class="meta">{published}</span>
				</div>
				<article class="paper post" aria-label="the write-up">
					<Content />
				</article>

				<footer class="foot">
					<div class="a">Inductive ML</div>
					<div class="b">Trust Yourself, Briefly · published {published}</div>
					<div class="c"><a href="/experiments">All experiments ↗</a></div>
				</footer>
			</div>
		</div>
	</main>
	<SiteFooter animate={true} />
</Layout>

<style>
	.post :global(h2:first-child) {
		margin-top: 0;
	}
	.post :global(h3) {
		font-family: var(--display);
		font-size: 21px;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.25;
		color: var(--ink);
		margin: 36px 0 12px;
	}
	.post :global(a) {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 3px;
	}
	.post :global(a:hover) {
		color: var(--accent);
	}
	.post :global(p code),
	.post :global(li code) {
		font-family: var(--mono);
		font-size: 0.82em;
		background: var(--accent-soft);
		color: var(--amber);
		padding: 1px 6px;
	}
	.post :global(pre) {
		font-family: var(--mono);
		font-size: 14px;
		line-height: 1.6;
		color: var(--ink);
		background: var(--panel);
		border: 1px solid var(--line);
		padding: 16px 20px;
		margin: 0 0 24px;
		overflow-x: auto;
	}
	@media (max-width: 480px) {
		.post :global(pre) {
			font-size: 13px;
			padding: 14px 16px;
		}
	}
	.post :global(blockquote) {
		margin: 0 0 24px;
		padding: 14px 20px;
		border-left: 3px solid var(--accent);
		background: var(--accent-soft);
	}
	.post :global(blockquote p) {
		font-family: var(--mono);
		font-size: 14px;
		color: var(--ink);
		margin: 0;
	}
	.post :global(figure) {
		margin: 32px 0;
		color: var(--ink);
	}
	.post :global(figure svg) {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 auto;
	}
	.post :global(figcaption) {
		font-family: var(--mono);
		font-size: 12px;
		line-height: 1.5;
		color: var(--mute);
		margin-top: 12px;
		border-top: 1px solid var(--line-2);
		padding-top: 10px;
	}
</style>
