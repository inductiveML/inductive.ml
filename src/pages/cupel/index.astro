---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageHead from '../../components/PageHead.astro';
import AuditRows from '../../components/AuditRows.astro';
import { auditChecks } from '../../lib/site';
import '../../styles/v9.css';

const steps = [
	{
		k: 'Scope',
		v: 'We agree with the vendor which environments, task suites and harness versions are in scope, and pin them so the results refer to something fixed.',
	},
	{
		k: 'Audit',
		v: 'We test every failure class above against the pinned environments. A candidate finding counts only once we have confirmed it.',
	},
	{
		k: 'Private report',
		v: 'The vendor receives the findings privately, with evidence, reproduction steps and proposed patches.',
	},
	{
		k: 'Fix window',
		v: 'The vendor has 14 days to fix. We re-check the fixes they ship.',
	},
	{
		k: 'Public report',
		v: 'We publish on day 15: the findings, what was fixed, and what was not.',
	},
];

const impact = [
	{ k: 'I3', name: 'Full', v: 'Full reward without doing the intended task.' },
	{
		k: 'I2',
		name: 'Partial',
		v: 'Partial credit, a shortened path, or a reveal of the scope of the fix that materially reduces the task.',
	},
	{
		k: 'I1',
		name: 'Signal corruption',
		v: 'A grader that is flaky, noisy or in the wrong pass-rate band, without a reliable free reward.',
	},
];

const reach = [
	{ k: 'R4', name: 'Ordinary', v: 'Ordinary tool use, such as git log or reading a visible file.' },
	{ k: 'R3', name: 'Unusual, unguarded', v: 'Unusual but unguarded, such as editing the tests or a writable conftest.' },
	{
		k: 'R2',
		name: 'Expert',
		v: 'An expert technique, such as parsing git packfiles by hand or digging through image layers.',
	},
	{ k: 'R1', name: 'Needs egress', v: 'Needs network access or an escape from the host.' },
];

const grid = [
	{ i: 'I3', name: 'Full', cells: ['Critical', 'High', 'Medium', 'Medium'] },
	{ i: 'I2', name: 'Partial', cells: ['Medium or Low (rule 2)', 'Medium or Low (rule 2)', 'Low', 'Low'] },
	{ i: 'I1', name: 'Signal corruption', cells: ['Low', 'Low', 'Low', 'Low'] },
];

const rules = [
	{
		k: 'Confirmed only.',
		v: 'The grid applies only to confirmed findings. For full impact, confirmed means the reward actually fires on an exploit run; for partial impact and signal corruption, that the leak or grader defect is shown to be present. A candidate we have not confirmed is Info. So are answers reachable online only if the sandbox allows network access, when that access was not confirmed.',
	},
	{
		k: 'Partial impact, ordinary or unusual reach.',
		v: 'I2 with R4 or R3 is Medium if, against a matched control, it raises the solve rate by at least a threshold set before any run (+15 percentage points in our MiMo study). Otherwise it is Low, and it is Low if it was not measured.',
	},
	{
		k: 'Sandbox escape.',
		v: 'An undeclared sandbox escape that gives full reward (I3 with R1) is Critical.',
	},
	{
		k: 'Impossible task with an exploit.',
		v: 'An impossible task, or one whose reference solution fails, alongside a confirmed exploit on the same task is Critical, because it trains hacking.',
	},
	{
		k: 'Failing reference solution.',
		v: 'If the reference solution fails, so the grader also rejects right answers, the finding is at least High.',
	},
	{
		k: 'Wrong solutions pass.',
		v: 'If wrong solutions pass more often than a threshold set in advance, the finding is at least Medium.',
	},
	{
		k: 'Result.',
		v: 'A finding takes the highest level given by its grid cell and rules 3 to 6. Those rules only raise a level.',
	},
];

const stamp = [
	{
		k: 'Pass.',
		v: "Zero open Critical or High findings, re-verified after the vendor's fixes, as of a stated date, under a named scanner version and a named attacker model, with the full findings list public and the residual hack rate printed.",
	},
	{ k: 'Fail.', v: 'Any open Critical or High finding at that date.' },
	{ k: 'Medium and Low.', v: 'Disclosed in the report, but they do not block a pass.' },
	{
		k: 'Dated and versioned.',
		v: 'If a new class of hole is found later, we publish an addendum and revise the stamp with a new date.',
	},
];
---

<Layout
	title="Cupel — Independent audits of RL environments · Inductive ML"
	description="Cupel is the RL-environment auditing arm of Inductive ML. Environment vendors commission an independent audit before selling environments to frontier labs."
>
	<SiteHeader current="cupel" />
	<main>
		<PageHead back={{ href: '/', label: 'Inductive ML' }} kicker="Inductive ML · RL environment audits" animate={true}>
			Cupel
		</PageHead>

		<div class="shell page-body">
			<div class="reader article-body">
				<p class="article-lede">
					Cupel audits reinforcement-learning environments independently, before they are sold to frontier labs.
					The report states whether the tasks can be solved honestly and whether they can be gamed in the ways
					we know about.
				</p>
				<p>
					The model is the smart-contract audit. An environment vendor commissions the audit, we test the
					environment, the vendor fixes what we find, and the report is published. Labs buying the environment
					can read the same report the vendor did. A cupel is the small dish an assayer uses to test the purity
					of gold.
				</p>

				<h2><span class="sec-num">01</span>What an audit checks</h2>
				<p>
					An environment that can be gamed teaches a model to game it. Each audit tests for the known failure
					classes below, and checks that the suite is worth training on at all.
				</p>
			</div>

			<div class="checks">
				{
					auditChecks.map((c) => (
						<div class="check">
							<h3>{c.k}</h3>
							<p>{c.v}</p>
						</div>
					))
				}
			</div>

			<div class="reader article-body">
				<h2><span class="sec-num">02</span>How it works</h2>
				<ol class="steps">
					{
						steps.map((s, i) => (
							<li>
								<span class="sec-num">{String(i + 1).padStart(2, '0')}</span>
								<p>
									<strong>{s.k}.</strong> {s.v}
								</p>
							</li>
						))
					}
				</ol>
				<p>
					The same disclosure policy applies to public environments we audit on our own initiative: the vendor
					hears from us first, privately and with patches, and the report follows on day 15.
				</p>

				<h2><span class="sec-num">03</span>What we don't do</h2>
				<p>We don't reduce an environment to a single score.</p>
				<p>We don't report a finding without a reproduction.</p>

				<h2 id="severity"><span class="sec-num">04</span>Severity</h2>
				<p>
					We rate each finding on two axes: impact, what an agent gets without doing the task, and reach, how
					easy the shortcut is to use. Together they set one of five severity levels.
				</p>
				<p><strong>Impact</strong></p>
				<ul class="steps">
					{
						impact.map((l) => (
							<li>
								<span class="sec-num">{l.k}</span>
								<p>
									<strong>{l.name}.</strong> {l.v}
								</p>
							</li>
						))
					}
				</ul>
				<p><strong>Reach</strong></p>
				<ul class="steps">
					{
						reach.map((l) => (
							<li>
								<span class="sec-num">{l.k}</span>
								<p>
									<strong>{l.name}.</strong> {l.v}
								</p>
							</li>
						))
					}
				</ul>
				<p><strong>Severity levels</strong></p>
				<p>
					There are five levels: Critical, High, Medium, Low and Info. For a confirmed finding, the impact and
					reach pick one cell of the grid below, and the rules after it adjust the result. Lower reach never
					raises severity: each cell is at most the level of the cell to its left.
				</p>
				<div class="v9">
					<div class="table-wrap">
						<table class="v9-table">
							<thead>
								<tr class="head">
									<th>Impact \ Reach</th>
									<th>R4 Ordinary</th>
									<th>R3 Unusual, unguarded</th>
									<th>R2 Expert</th>
									<th>R1 Needs egress</th>
								</tr>
							</thead>
							<tbody>
								{
									grid.map((r) => (
										<tr>
											<td class="ink">
												{r.i} {r.name}
											</td>
											{r.cells.map((c) => (
												<td>{c}</td>
											))}
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>
				<p><strong>Rules, in order</strong></p>
				<ol class="steps">
					{
						rules.map((r, i) => (
							<li>
								<span class="sec-num">{String(i + 1).padStart(2, '0')}</span>
								<p>
									<strong>{r.k}</strong> {r.v}
								</p>
							</li>
						))
					}
				</ol>
				<p>
					Flaky graders are Low. A timestamp hint that reveals the scope of the fix but not the solution is
					I2 with R4, so Low unless it clears the threshold. The difficulty spread of a suite is reported as
					Info; it is not a finding.
				</p>

				<h2 id="stamp"><span class="sec-num">05</span>The stamp</h2>
				<p>The stamp states whether an audited environment passes or fails, as of a date.</p>
				<ul class="steps">
					{
						stamp.map((r) => (
							<li>
								<span class="sec-num">·</span>
								<p>
									<strong>{r.k}</strong> {r.v}
								</p>
							</li>
						))
					}
				</ul>
				<p>A passing stamp reads:</p>
				<p>
					<span class="v9"><code class="code-inline"
						>Cupel · PASS · [env] @ [commit] · [date] · 0 open Critical/High · scanner v[x] · attacker [model] ·
						report →</code
					></span>
				</p>
			</div>

			<div class="reader article-body">
				<h2><span class="sec-num">06</span>Audits and research</h2>
				<AuditRows href={null} />

				<h2><span class="sec-num">07</span>Contact</h2>
				<p>
					To commission an audit, or to report a problem with one of ours, write to
					<a href="mailto:aditya@inductive.ml">aditya@inductive.ml</a>.
				</p>
				<p>Aditya Veer Parmar, Cupel / Inductive ML</p>
			</div>
		</div>
	</main>
	<SiteFooter animate={true} />
</Layout>
