---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHead from '../components/PageHead.astro';
import ExperimentRows from '../components/ExperimentRows.astro';
---

<Layout
	title="Experiments — Inductive ML"
	description="Open research and experiments from the lab on representation, adaptation, and the geometry of learning."
>
	<SiteHeader current="experiments" />
	<main>
		<PageHead back={{ href: '/', label: 'Inductive ML' }} kicker="Open research from the lab" animate={true}>
			Experiments
		</PageHead>
		<div class="shell page-body">
			<ExperimentRows />
			<p class="exp-pointer">
				Oct 2026: MiMo RL environment audit. Xiaomi's git-history fix holds, and a file-timestamp leak makes agents faster without raising their solve rate.
				<a href="/cupel/mimo">Read the audit →</a>
			</p>
		</div>
	</main>
	<SiteFooter animate={true} />
</Layout>

<style>
	.exp-pointer {
		margin-top: 32px;
		font-size: 14px;
		color: var(--mute);
	}
	.exp-pointer a {
		color: inherit;
		text-decoration: underline;
	}
</style>
