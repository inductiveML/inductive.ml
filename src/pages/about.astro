---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHead from '../components/PageHead.astro';
import { isExternal, profile } from '../lib/site';
---

<Layout
	title="About — Inductive ML"
	description="Inductive ML is an independent AI research lab in Bangalore studying how learned systems represent, adapt, and generalize. Founded by Aditya Veer Parmar."
>
	<SiteHeader current="about" />
	<main>
		<PageHead
			back={{ href: '/', label: 'Inductive ML' }}
			kicker="Independent AI research lab · Bangalore"
			animate={true}
		>
			About the lab
		</PageHead>
		<div class="shell page-body">
			<section class="sec-ruled" aria-label="About the lab">
				<div class="stack col-wide">
					<p class="lead">
						Inductive ML is an independent research lab studying how learned systems represent, adapt, and
						generalize.
					</p>
					<p class="copy">
						The lab pursues small, sharp programs at the frontier of intelligence — representation geometry,
						efficient adaptation, and systems that reveal how intelligence is organized. Work is published
						openly and run end-to-end by the people doing it.
					</p>
					<p class="copy">
						It is founded and run by Aditya Veer Parmar, an independent ML researcher and software engineer
						based in Bangalore, India — designing the experiments, writing the code, and publishing the
						notes. The lab welcomes correspondence from researchers, students, and reviewers.
					</p>
				</div>
				<div class="col-side">
					<p class="eyebrow">Correspondence</p>
					<div class="list">
						{
							profile.map((p) => (
								<a
									class="list-row profile-row"
									href={p.href}
									target={isExternal(p.href) ? '_blank' : undefined}
									rel={isExternal(p.href) ? 'noreferrer' : undefined}
								>
									<span class="k">{p.k}</span>
									<span class="v">{p.v} ↗</span>
								</a>
							))
						}
					</div>
				</div>
			</section>
		</div>
	</main>
	<SiteFooter animate={true} />
</Layout>
