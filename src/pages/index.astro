---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HalftoneBand from '../components/HalftoneBand.astro';
import ExperimentRows from '../components/ExperimentRows.astro';
import AuditRows from '../components/AuditRows.astro';
import ReleaseRows from '../components/ReleaseRows.astro';
import OrgLinks from '../components/OrgLinks.astro';
import { auditChecks, github, huggingFace, isExternal, mlxrl, profile, releases, splitHighlight } from '../lib/site';

const mlxrlParts = splitHighlight(mlxrl.note, mlxrl.highlight);
const otherReleases = releases.filter((r) => r !== mlxrl);
---

<Layout>
	<SiteHeader current={null} />

	<main>
		<div class="shell">
			<section class="hero">
				<p class="kicker">Independent AI research · Est. 2026 · Bangalore</p>
				<h1>Better intelligence through <span class="accent">simpler ideas.</span></h1>
				<p class="lede">Research on representation, adaptation, and intelligence.</p>
				<div class="ctas">
					<a class="cta cta-fill" href="/experiments">Experiments →</a>
					<a class="cta" href="/cupel">RL Env Audits →</a>
					<a class="cta" href={mlxrl.href} target="_blank" rel="noreferrer">MLXRL ↗</a>
					<a class="cta" href={github.href} target="_blank" rel="noreferrer">GitHub ↗</a>
					<a class="cta" href={huggingFace.href} target="_blank" rel="noreferrer">Hugging Face ↗</a>
				</div>
			</section>
		</div>

		<HalftoneBand animate={true} />

		<div class="shell">
			<nav class="section-index" aria-label="Sections">
				<a href="#experiments"><span>01</span>Experiments</a>
				<a href="#open-source"><span>02</span>Open source</a>
				<a href="#cupel"><span>03</span>Cupel</a>
				<a href="#about"><span>04</span>About the lab</a>
			</nav>

			<section id="experiments" class="sec" aria-labelledby="experiments-h">
				<div class="sec-head">
					<h2 id="experiments-h"><span class="sec-num">01</span>Experiments</h2>
					<p class="kicker">Open research from the lab</p>
				</div>
				<ExperimentRows />
			</section>

			<section id="open-source" class="sec sec-ruled" aria-labelledby="open-source-h">
				<div class="stack col-main">
					<p class="kicker">Open source · Code and weights</p>
					<h2 id="open-source-h" class="sec-title"><span class="sec-num">02</span>Open source</h2>
					<div class="feature">
						<p class="eyebrow">Library · Apple Silicon</p>
						<p class="feature-name">{mlxrl.name}</p>
						<p class="lead">
							{mlxrlParts.before}
							<span class="mark">{mlxrlParts.mark}</span>
							{mlxrlParts.after}
						</p>
						<pre class="feature-code"><code>git clone {mlxrl.href}.git</code></pre>
						<div class="ctas">
							<a class="cta cta-fill" href={mlxrl.href} target="_blank" rel="noreferrer">MLXRL on GitHub ↗</a>
							<a class="cta" href={mlxrl.usedIn} target="_blank" rel="noreferrer">See it in use ↗</a>
						</div>
					</div>
					<OrgLinks />
				</div>
				<div class="col-side">
					<p class="eyebrow">Libraries, models and code</p>
					<ReleaseRows items={otherReleases} />
				</div>
			</section>

			<section id="cupel" class="sec sec-ruled" aria-labelledby="cupel-h">
				<div class="stack col-main">
					<p class="kicker">Inductive ML · RL environment audits</p>
					<h2 id="cupel-h" class="sec-title cupel-title"><span class="sec-num">03</span>Cupel</h2>
					<p class="lead">
						Cupel audits reinforcement-learning environments independently, before they are sold to frontier
						labs. The report states whether the tasks can be solved honestly and whether they can be gamed in
						the ways we know about.
					</p>
					<p class="copy">
						The model is the smart-contract audit. An environment vendor commissions the audit, we test the
						environment, the vendor fixes what we find, and the report is published. Labs buying the
						environment can read the same report the vendor did.
					</p>
					<a class="mono-link" href="/cupel">RL Env Audits →</a>
				</div>
				<div class="col-side">
					<p class="eyebrow">Audits and research</p>
					<AuditRows href="/cupel" />
					<p class="eyebrow eyebrow-gap">What an audit checks</p>
					<div class="chips">
						{auditChecks.map((c) => <div class="chip">{c.k}</div>)}
					</div>
				</div>
			</section>

			<section id="about" class="sec sec-ruled" aria-labelledby="about-h">
				<div class="stack col-label">
					<p class="kicker">Independent AI research lab · Bangalore</p>
					<h2 id="about-h" class="sec-title"><span class="sec-num">04</span>About the lab</h2>
				</div>
				<div class="stack col-wide">
					<p class="lead">
						Inductive ML is an independent research lab studying how learned systems represent, adapt, and
						generalize.
					</p>
					<p class="copy">
						The lab pursues small, sharp programs at the frontier of intelligence — representation geometry,
						efficient adaptation, and systems that reveal how intelligence is organized. Work is published
						openly and run end-to-end by the people doing it.
					</p>
					<p class="copy">
						It is founded and run by Aditya Veer Parmar, an independent ML researcher and software engineer
						based in Bangalore, India — designing the experiments, writing the code, and publishing the
						notes. The lab welcomes correspondence from researchers, students, and reviewers.
					</p>
					<div class="link-list">
						{
							profile.map((p) => (
								<a
									class="mono-link"
									href={p.href}
									target={isExternal(p.href) ? '_blank' : undefined}
									rel={isExternal(p.href) ? 'noreferrer' : undefined}
								>
									{p.k} ↗
								</a>
							))
						}
					</div>
				</div>
			</section>
		</div>
	</main>

	<SiteFooter animate={true} />
</Layout>
